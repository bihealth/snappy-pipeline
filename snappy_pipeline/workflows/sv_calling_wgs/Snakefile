# -*- coding: utf-8 -*-
"""CUBI Pipeline sv_calling_wgs step Snakefile"""

from snappy_pipeline.orchestration import task_instance

__author__ = "Manuel Holtgrewe <manuel.holtgrewe@bihealth.de>"


# Regular expression for wildcard constraints
RE_BETWEEN_DOTS = r"[^.\.]+"

# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])
tool = str(wf.config.tool)


# Rules =======================================================================


# House-Keeping ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Write out pedigree file -----------------------------------------------------


rule sv_calling_wgs_write_pedigree_run:
    output:
        wf.get_output_files("write_pedigree", "run"),
    localrule: True
    params:
        args=wf.get_params("write_pedigree", "run"),
    run:
        wf.sub_steps["write_pedigree"].write(params.args, output)


# Structural Variant Calling ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

if tool == "manta":

    # Run Manta ----------------------------------------------------------------

    rule sv_calling_wgs_manta_run:
        input:
            unpack(wf.get_input_files("manta", "run")),
        output:
            **wf.get_output_files("manta", "run"),
        log:
            **wf.get_log_file("manta", "run"),
        benchmark:
            wf.get_benchmark_file("manta", "run")
        threads: wf.get_resource("manta", "run", "threads")
        resources:
            **wf.get_resources("manta", "run"),
        params:
            args=wf.get_params("manta", "run"),
        wrapper:
            wf.get_wrapper("manta", "run")

