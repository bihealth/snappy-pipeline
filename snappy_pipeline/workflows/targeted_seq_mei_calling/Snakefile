# -*- coding: utf-8 -*-
"""CUBI Pipeline mobile_element_insertion step Snakefile"""

from snappy_pipeline.orchestration import task_instance

# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


# Rules =======================================================================


rule mobile_element_insertion_scramble_cluster:
    input:
        wf.get_input_files("scramble", "cluster"),
    output:
        **wf.get_output_files("scramble", "cluster"),
    log:
        **wf.get_log_file("scramble", "cluster"),
    benchmark:
        wf.get_benchmark_file("scramble", "cluster")
    threads: wf.get_resource("scramble", "cluster", "threads")
    resources:
        **wf.get_resources("scramble", "cluster"),
    params:
        args=wf.get_params("scramble", "cluster"),
    wrapper:
        wf.get_wrapper("scramble", "cluster")


rule mobile_element_insertion_scramble_analysis:
    input:
        unpack(wf.get_input_files("scramble", "analysis")),
    output:
        **wf.get_output_files("scramble", "analysis"),
    log:
        **wf.get_log_file("scramble", "analysis"),
    benchmark:
        wf.get_benchmark_file("scramble", "analysis")
    threads: wf.get_resource("scramble", "analysis", "threads")
    resources:
        **wf.get_resources("scramble", "analysis"),
    params:
        args=wf.get_params("scramble", "analysis"),
    wrapper:
        wf.get_wrapper("scramble", "analysis")
