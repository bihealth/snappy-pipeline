# pVACsplice-only rules -------------------------------------------------------


if "pvacsplice" in wf.config["tools"]:

    rule somatic_neoepitope_junction:
        input:
            unpack(wf.get_input_files("pvacsplice", "junction")),
        output:
            **wf.get_output_files("pvacsplice", "junction"),
        log:
            **wf.get_log_file("pvacsplice", "junction"),
        threads: wf.get_resource("pvacsplice", "junction", "threads")
        resources:
            time=wf.get_resource("pvacsplice", "junction", "time"),
            memory=wf.get_resource("pvacsplice", "junction", "memory"),
            partition=wf.get_resource("pvacsplice", "junction", "partition"),
            tmpdir=wf.get_resource("pvacsplice", "junction", "tmpdir"),
        params:
            args=wf.get_args("pvacsplice", "junction"),
        wrapper:
            wf.wrapper_path("pvactools/junction")

    rule somatic_neoepitope_pvacsplice_workaround:
        input:
            features=wf.w_config["static_data_config"]["features"]["path"],
        output:
            gtf="work/pvacsplice_workaround/out/features.gtf",
        run:
            import gzip
            import re

            pattern = re.compile(r'^(.+)gene_id "(ENSG[0-9]{11})\.[0-9]+([^"]*)"(.*)')
            with open(output.gtf, "wt") as g:
                if input.features.endswith(".gz"):
                    f = gzip.open(input.features, "rt")
                else:
                    f = open(input.features, "rt")
                for line in f:
                    line = line.strip()
                    m = pattern.match(line)
                    if m:
                        line = (
                            m.group(1)
                            + 'gene_id "'
                            + m.group(2)
                            + m.group(3)
                            + '"'
                            + m.group(4)
                        )
                    g.write(line + "\n")
                f.close()

    rule somatic_neoepitope_prediction_pvacsplice:
        input:
            unpack(wf.get_input_files("pvacsplice", "pvacsplice")),
        output:
            **wf.get_output_files("pvacsplice", "pvacsplice"),
        log:
            **wf.get_log_file("pvacsplice", "pvacsplice"),
        threads: wf.get_resource("pvacsplice", "pvacsplice", "threads")
        resources:
            time=wf.get_resource("pvacsplice", "pvacsplice", "time"),
            memory=wf.get_resource("pvacsplice", "pvacsplice", "memory"),
            partition=wf.get_resource("pvacsplice", "pvacsplice", "partition"),
            tmpdir=wf.get_resource("pvacsplice", "pvacsplice", "tmpdir"),
        params:
            args=wf.get_args("pvacsplice", "pvacsplice"),
        wrapper:
            wf.wrapper_path("pvactools/pvacsplice")


