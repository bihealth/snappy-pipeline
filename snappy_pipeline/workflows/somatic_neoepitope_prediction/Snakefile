# -*- coding: utf-8 -*-
"""CUBI Pipeline somatic_neoepitope_prediction step Snakefile"""

from snappy_pipeline.orchestration import task_instance

__author__ = "Eric Blanc"


# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


include: "../common/wrapper_rules.rules"


tools = wf.config.pvactools


# pVACseq ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~


if tools.pvacseq.enabled:

    rule pvacseq_run:
        input:
            unpack(wf.get_input_files("pvacseq", "run")),
        output:
            **wf.get_output_files("pvacseq", "run"),
        log:
            **wf.get_log_file("pvacseq", "run"),
        benchmark:
            wf.get_benchmark_file("pvacseq", "run")
        threads: wf.get_resource("pvacseq", "run", "threads")
        resources:
            **wf.get_resources("pvacseq", "run"),
        params:
            args=wf.get_params("pvacseq", "run"),
        # fmt: off
        software:
            container(image_uri=tools.container)
        # fmt: on
        wrapper:
            wf.get_wrapper("pvacseq", "run")


# pVACfuse ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

if tools.pvacfuse.enabled:

    rule pvacfuse_run:
        input:
            unpack(wf.get_input_files("pvacfuse", "run")),
        output:
            **wf.get_output_files("pvacfuse", "run"),
        log:
            **wf.get_log_file("pvacfuse", "run"),
        benchmark:
            wf.get_benchmark_file("pvacfuse", "run")
        threads: wf.get_resource("pvacfuse", "run", "threads")
        resources:
            **wf.get_resources("pvacfuse", "run"),
        params:
            args=wf.get_params("pvacfuse", "run"),
        # fmt: off
        software:
            container(image_uri=tools.container)
        # fmt: on
        wrapper:
            wf.get_wrapper("pvacfuse", "run")


# pVACsplice ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

if tools.pvacsplice.enabled:

    rule pvacsplice_run:
        input:
            unpack(wf.get_input_files("pvacsplice", "run")),
        output:
            **wf.get_output_files("pvacsplice", "run"),
        log:
            **wf.get_log_file("pvacsplice", "run"),
        benchmark:
            wf.get_benchmark_file("pvacsplice", "run")
        threads: wf.get_resource("pvacsplice", "run", "threads")
        resources:
            **wf.get_resources("pvacsplice", "run"),
        params:
            args=wf.get_params("pvacsplice", "run"),
        # fmt: off
        software:
            container(image_uri=tools.container)
        # fmt: on
        wrapper:
            wf.get_wrapper("pvacsplice", "run")


# Post-processing ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

predictions = [getattr(tools, name) for name in wf.enabled_predictions]


if any(prediction.netmhc_stab.enabled for prediction in predictions):

    rule netstab_run:
        input:
            unpack(wf.get_input_files("netstab", "run")),
        output:
            **wf.get_output_files("netstab", "run"),
        log:
            **wf.get_log_file("netstab", "run"),
        benchmark:
            wf.get_benchmark_file("netstab", "run")
        threads: wf.get_resource("netstab", "run", "threads")
        resources:
            **wf.get_resources("netstab", "run"),
        params:
            args=wf.get_params("netstab", "run"),
        # fmt: off
        software:
            container(image_uri=tools.container)
        # fmt: on
        wrapper:
            wf.get_wrapper("netstab", "run")
