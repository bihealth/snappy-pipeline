# -*- coding: utf-8 -*-
"""CUBI Pipeline somatic_neoepitope_prediction step Snakefile"""

from snappy_pipeline.orchestration import task_instance

__author__ = "Eric Blanc"


# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])
tools = wf.config.pvactools

# Rules =======================================================================


rule somatic_neoepitope_prediction_all:
    default_target: True
    input:
        wf.get_result_files(),


# Preparation ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

if not tools.container:

    rule somatic_neoepitope_prediction_pvactools_install:
        output:
            **wf.get_output_files("pvactools", "install"),
        log:
            **wf.get_log_file("pvactools", "install"),
        threads: wf.get_resource("pvactools", "install", "threads")
        resources:
            runtime=wf.get_resource("pvactools", "install", "runtime"),
            mem=wf.get_resource("pvactools", "install", "mem"),
            partition=wf.get_resource("pvactools", "install", "partition"),
            tmpdir=wf.get_resource("pvactools", "install", "tmpdir"),
        params:
            image="docker://griffithlab/pvactools:7.1.3",
        shell:
            "apptainer build --ignore-proot {output.container} {params.image} > {log.log} 2>&1"


if tools.pvacseq.enabled or tools.pvacsplice.enabled:

    rule somatic_neoepitope_prediction_pvactools_normalize:
        input:
            unpack(wf.get_input_files("pvactools", "normalize")),
        output:
            **wf.get_output_files("pvactools", "normalize"),
        log:
            **wf.get_log_file("pvactools", "normalize"),
        benchmark:
            wf.get_benchmark_file("pvactools", "normalize")
        threads: wf.get_resource("pvactools", "normalize", "threads")
        resources:
            runtime=wf.get_resource("pvactools", "normalize", "runtime"),
            mem=wf.get_resource("pvactools", "normalize", "mem"),
            partition=wf.get_resource("pvactools", "normalize", "partition"),
            tmpdir=wf.get_resource("pvactools", "normalize", "tmpdir"),
        params:
            args=wf.get_params("pvactools", "normalize"),
        wrapper:
            wf.wrapper_path("pvactools/normalize")


