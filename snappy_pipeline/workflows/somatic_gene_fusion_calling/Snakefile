# -*- coding: utf-8 -*-
"""CUBI Pipeline somatic_gene_fusion_calling step Snakefile"""

from snappy_pipeline.orchestration import task_instance

__author__ = "Manuel Holtgrewe <manuel.holtgrewe@bihealth.de>"


# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])

# Rules =======================================================================


rule somatic_gene_fusion_calling_all:
    default_target: True
    input:
        wf.get_result_files(),


# House-Keeping ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Somatic Gene Fusion Calling ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

if str(wf.config.tool) == "star_fusion":

    rule somatic_gene_fusion_calling_star_fusion_run:
        input:
            unpack(wf.get_input_files("star_fusion", "run")),
        output:
            **wf.get_output_files("star_fusion", "run"),
        log:
            **wf.get_log_file("star_fusion", "run"),
        benchmark:
            wf.get_benchmark_file("star_fusion", "run")
        threads: wf.get_resource("star_fusion", "run", "threads")
        resources:
            runtime=wf.get_resource("star_fusion", "run", "runtime"),
            mem=wf.get_resource("star_fusion", "run", "mem"),
            partition=wf.get_resource("star_fusion", "run", "partition"),
            tmpdir=wf.get_resource("star_fusion", "run", "tmpdir"),
        wrapper:
            wf.wrapper_path("star_fusion")

elif str(wf.config.tool) == "arriba":

    rule somatic_gene_fusion_calling_arriba_run:
        input:
            unpack(wf.get_input_files("arriba", "run")),
        output:
            **wf.get_output_files("arriba", "run"),
        log:
            **wf.get_log_file("arriba", "run"),
        benchmark:
            wf.get_benchmark_file("arriba", "run")
        threads: wf.get_resource("arriba", "run", "threads")
        resources:
            runtime=wf.get_resource("arriba", "run", "runtime"),
            mem=wf.get_resource("arriba", "run", "mem"),
            partition=wf.get_resource("arriba", "run", "partition"),
            tmpdir=wf.get_resource("arriba", "run", "tmpdir"),
        params:
            args=wf.get_params("arriba", "run"),
        wrapper:
            wf.wrapper_path("arriba/run")
