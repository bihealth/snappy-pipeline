    resources:
        runtime=wf.get_resource("gatk_read_backed_phasing_only", "run", "runtime"),
        mem=wf.get_resource("gatk_read_backed_phasing_only", "run", "mem"),
        partition=wf.get_resource("gatk_read_backed_phasing_only", "run", "partition"),
        tmpdir=wf.get_resource("gatk_read_backed_phasing_only", "run", "tmpdir"),
    params:
        args=wf.get_params("gatk_read_backed_phasing_only", "run"),
    wrapper:
        wf.wrapper_path("gatk_read_backed_phasing")


rule variant_phasing_gatk_read_backed_phasing_only_gather:
    input:
        unpack(wf.get_input_files("gatk_read_backed_phasing_only", "gather")),
    output:
        **wf.get_output_files("gatk_read_backed_phasing_only", "gather"),
