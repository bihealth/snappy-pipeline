# -*- coding: utf-8 -*-
"""CUBI Pipeline variant_phasing step Snakefile"""

from snappy_pipeline.orchestration import task_instance
from snappy_pipeline.workflows.variant_phasing.model import Tool

__author__ = "Manuel Holtgrewe <manuel.holtgrewe@bihealth.de>"


# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


# Rules =======================================================================


localrules:
    # Writing pedigrees should be done locally as well
    variant_phasing_write_trio_pedigree_run,


rule variant_phasing_all:
    default_target: True
    input:
        wf.get_result_files(),


# Variant Phasing ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Write out trio pedigree file ------------------------------------------------


rule variant_phasing_write_trio_pedigree_run:
    output:
        wf.get_output_files("write_trio_pedigree", "run"),
    run:
        wf.substep_dispatch("write_trio_pedigree", "run", wildcards, output)


if wf.config.tool == Tool.gatk_phase_by_transmission:
    # GATK PhaseByTransmission ------------------------------------------------

    rule variant_phasing_gatk_phase_by_transmission_run:
        input:
            unpack(wf.get_input_files("gatk_phase_by_transmission", "run")),
        output:
            **wf.get_output_files("gatk_phase_by_transmission", "run"),
        log:
            **wf.get_log_file("gatk_phase_by_transmission", "run"),
        benchmark:
            wf.get_benchmark_file("gatk_phase_by_transmission", "run")
        threads: wf.get_resource("gatk_phase_by_transmission", "run", "threads")
        resources:
            runtime=wf.get_resource("gatk_phase_by_transmission", "run", "runtime"),
            mem=wf.get_resource("gatk_phase_by_transmission", "run", "mem"),
            partition=wf.get_resource("gatk_phase_by_transmission", "run", "partition"),
            tmpdir=wf.get_resource("gatk_phase_by_transmission", "run", "tmpdir"),
        params:
            args=wf.get_params("gatk_phase_by_transmission", "run"),
        wrapper:
            wf.wrapper_path("gatk_phase_by_transmission")

elif wf.config.tool == Tool.gatk_read_backed_phasing:
    # GATK ReadBackedPhasing, scattered over chunks of the genome -------------

    scattergather:
        gatk_read_backed_phasing=wf.config.gatk_read_backed_phasing.num_jobs,

    rule variant_phasing_gatk_read_backed_phasing_scatter:
        input:
            unpack(wf.get_input_files("gatk_read_backed_phasing", "scatter")),
        output:
            **wf.get_output_files("gatk_read_backed_phasing", "scatter"),
        log:
            **wf.get_log_file("gatk_read_backed_phasing", "scatter"),
        benchmark:
            wf.get_benchmark_file("gatk_read_backed_phasing", "scatter")
        localrule: True
        threads: wf.get_resource("gatk_read_backed_phasing", "scatter", "threads")
        resources:
            runtime=wf.get_resource("gatk_read_backed_phasing", "scatter", "runtime"),
            mem=wf.get_resource("gatk_read_backed_phasing", "scatter", "mem"),
            partition=wf.get_resource("gatk_read_backed_phasing", "scatter", "partition"),
            tmpdir=wf.get_resource("gatk_read_backed_phasing", "scatter", "tmpdir"),
        params:
            args=wf.get_params("gatk_read_backed_phasing", "scatter"),
        wrapper:
            wf.wrapper_path("split_regions")

    rule variant_phasing_gatk_read_backed_phasing_run:
        input:
            unpack(wf.get_input_files("gatk_read_backed_phasing", "run")),
        output:
            **wf.get_output_files("gatk_read_backed_phasing", "run"),
        log:
            **wf.get_log_file("gatk_read_backed_phasing", "run"),
        benchmark:
            wf.get_benchmark_file("gatk_read_backed_phasing", "run")
        threads: wf.get_resource("gatk_read_backed_phasing", "run", "threads")
        resources:
            runtime=wf.get_resource("gatk_read_backed_phasing", "run", "runtime"),
            mem=wf.get_resource("gatk_read_backed_phasing", "run", "mem"),
            partition=wf.get_resource("gatk_read_backed_phasing", "run", "partition"),
            tmpdir=wf.get_resource("gatk_read_backed_phasing", "run", "tmpdir"),
        params:
            args=wf.get_params("gatk_read_backed_phasing", "run"),
        wrapper:
            wf.wrapper_path("gatk_read_backed_phasing")

    rule variant_phasing_gatk_read_backed_phasing_gather:
        input:
            unpack(wf.get_input_files("gatk_read_backed_phasing", "gather")),
        output:
            **wf.get_output_files("gatk_read_backed_phasing", "gather"),
        log:
            **wf.get_log_file("gatk_read_backed_phasing", "gather"),
        benchmark:
            wf.get_benchmark_file("gatk_read_backed_phasing", "gather")
        threads: wf.get_resource("gatk_read_backed_phasing", "gather", "threads")
        resources:
            runtime=wf.get_resource("gatk_read_backed_phasing", "gather", "runtime"),
            mem=wf.get_resource("gatk_read_backed_phasing", "gather", "mem"),
            partition=wf.get_resource("gatk_read_backed_phasing", "gather", "partition"),
            tmpdir=wf.get_resource("gatk_read_backed_phasing", "gather", "tmpdir"),
        wrapper:
            wf.wrapper_path("bcftools/concat")

elif wf.config.tool == Tool.gatk_read_backed_phasing_tumor:
    # GATK ReadBackedPhasing of tumor libraries ---------------------------------

    rule variant_phasing_gatk_read_backed_phasing_tumor_run:
        input:
            unpack(wf.get_input_files("gatk_read_backed_phasing_tumor", "run")),
        output:
            **wf.get_output_files("gatk_read_backed_phasing_tumor", "run"),
        log:
            **wf.get_log_file("gatk_read_backed_phasing_tumor", "run"),
        benchmark:
            wf.get_benchmark_file("gatk_read_backed_phasing_tumor", "run")
        threads: wf.get_resource("gatk_read_backed_phasing_tumor", "run", "threads")
        resources:
            runtime=wf.get_resource("gatk_read_backed_phasing_tumor", "run", "runtime"),
            mem=wf.get_resource("gatk_read_backed_phasing_tumor", "run", "mem"),
            partition=wf.get_resource("gatk_read_backed_phasing_tumor", "run", "partition"),
            tmpdir=wf.get_resource("gatk_read_backed_phasing_tumor", "run", "tmpdir"),
        wrapper:
            wf.wrapper_path("gatk_read_backed_phasing_tumor")

elif wf.config.tool == Tool.whatshap_tumor:
    # WhatsHap phasing of tumor libraries -------------------------------------------

    rule variant_phasing_whatshap_tumor_run:
        input:
            unpack(wf.get_input_files("whatshap_tumor", "run")),
        output:
            **wf.get_output_files("whatshap_tumor", "run"),
        log:
            **wf.get_log_file("whatshap_tumor", "run"),
        benchmark:
            wf.get_benchmark_file("whatshap_tumor", "run")
        threads: wf.get_resource("whatshap_tumor", "run", "threads")
        resources:
            runtime=wf.get_resource("whatshap_tumor", "run", "runtime"),
            mem=wf.get_resource("whatshap_tumor", "run", "mem"),
            partition=wf.get_resource("whatshap_tumor", "run", "partition"),
            tmpdir=wf.get_resource("whatshap_tumor", "run", "tmpdir"),
        wrapper:
            wf.wrapper_path("whatshap/phase")

else:
    raise ValueError(f"unknown tool {wf.config.tool}")
