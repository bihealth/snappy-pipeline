# -*- coding: utf-8 -*-
"""CUBI Pipeline variant_phasing step Snakefile"""

from snappy_pipeline.orchestration import task_instance

__author__ = "Manuel Holtgrewe <manuel.holtgrewe@bihealth.de>"


# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


# Rules =======================================================================


localrules:
    # Linking files from work/ to output/ should be done locally
    variant_phasing_link_out_run,
    # Writing pedigrees should be done locally as well
    variant_checking_write_trio_pedigree_run,


rule variant_phasing_all:
    default_target: True
    input:
        wf.get_result_files(),


# House-Keeping ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Generic linking out ---------------------------------------------------------


rule variant_phasing_link_out_run:
    input:
        wf.get_input_files("link_out", "run"),
    output:
        wf.get_output_files("link_out", "run"),
    run:
        wf.run_locally("link_out", "run", wildcards)


# Variant Phasing ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Write out trio pedigree file ------------------------------------------------


rule variant_checking_write_trio_pedigree_run:
    output:
        wf.get_output_files("write_trio_pedigree", "run"),
    run:
        wf.substep_dispatch("write_trio_pedigree", "run", wildcards, output)


# GATK PhaseByTransmission ----------------------------------------------------


rule variant_phasing_gatk_phase_by_transmission_run:
    input:
        unpack(wf.get_input_files("gatk_phase_by_transmission", "run")),
    output:
        **wf.get_output_files("gatk_phase_by_transmission", "run"),
    log:
        **wf.get_log_file("gatk_phase_by_transmission", "run"),
    threads: wf.get_resource("gatk_phase_by_transmission", "run", "threads")
    resources:
        runtime=wf.get_resource("gatk_phase_by_transmission", "run", "runtime"),
        mem=wf.get_resource("gatk_phase_by_transmission", "run", "mem"),
        partition=wf.get_resource("gatk_phase_by_transmission", "run", "partition"),
        tmpdir=wf.get_resource("gatk_phase_by_transmission", "run", "tmpdir"),
    params:
        args=wf.get_params("gatk_phase_by_transmission", "run"),
    wrapper:
        wf.wrapper_path("gatk_phase_by_transmission")


# GATK ReadBackedPhasing, scattered over chunks of the genome -----------------


scattergather:
    gatk_read_backed_phasing=wf.config.gatk_read_backed_phasing.num_jobs,


# GATK ReadBackedPhasing (only) -----------------------------------------------


rule variant_phasing_gatk_read_backed_phasing_only_scatter:
    input:
        unpack(wf.get_input_files("gatk_read_backed_phasing_only", "scatter")),
    output:
        **wf.get_output_files("gatk_read_backed_phasing_only", "scatter"),
    log:
        **wf.get_log_file("gatk_read_backed_phasing_only", "scatter"),
    localrule: True
    threads: wf.get_resource("gatk_read_backed_phasing_only", "scatter", "threads")
    resources:
        runtime=wf.get_resource("gatk_read_backed_phasing_only", "scatter", "runtime"),
        mem=wf.get_resource("gatk_read_backed_phasing_only", "scatter", "mem"),
        partition=wf.get_resource("gatk_read_backed_phasing_only", "scatter", "partition"),
        tmpdir=wf.get_resource("gatk_read_backed_phasing_only", "scatter", "tmpdir"),
    params:
        args=wf.get_params("gatk_read_backed_phasing_only", "scatter"),
    wrapper:
        wf.wrapper_path("split_regions")


rule variant_phasing_gatk_read_backed_phasing_only_run:
    input:
        unpack(wf.get_input_files("gatk_read_backed_phasing_only", "run")),
