# Compute protocol strandedness for STAR --------------------------------------


rule ngs_mapping_infer_strandedness:
    input:
        unpack(wf.get_input_files("strandedness", "infer")),
    output:
        **wf.get_output_files("strandedness", "infer"),
    log:
        **wf.get_log_file("strandedness", "infer"),
