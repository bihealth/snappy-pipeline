# -*- coding: utf-8 -*-
"""CUBI Pipeline repeat_expansion step Snakefile"""

from snappy_pipeline.orchestration import task_instance

# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


include: "../common/wrapper_rules.rules"


# Rules =======================================================================


rule annotate_expansionhunter:
    input:
        unpack(wf.get_input_files("expansionhunter", "annotate")),
    output:
        **wf.get_output_files("expansionhunter", "annotate"),
    threads: wf.get_resource("expansionhunter", "annotate", "threads")
    resources:
        **wf.get_resources("expansionhunter", "annotate"),
    run:
        wf.sub_steps["expansionhunter"].annotate_results(wildcards, input, output)
