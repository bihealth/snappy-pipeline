# -*- coding: utf-8 -*-
"""CUBI Pipeline repeat_expansion step Snakefile"""

from snappy_pipeline.orchestration import task_instance

# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


# Rules =======================================================================


rule repeat_expansion_run_expansionhunter:
    input:
        unpack(wf.get_input_files("expansionhunter", "run")),
    output:
        **wf.get_output_files("expansionhunter", "run"),
    log:
        **wf.get_log_file("expansionhunter", "run"),
    benchmark:
        wf.get_benchmark_file("expansionhunter", "run")
    wildcard_constraints:
        library_name=r"(?!annotated\.).+",
    threads: wf.get_resource("expansionhunter", "run", "threads")
    resources:
        **wf.get_resources("expansionhunter", "run"),
    params:
        args=wf.get_params("expansionhunter", "run"),
    wrapper:
        wf.get_wrapper("expansionhunter", "run")


rule repeat_expansion_annotate_expansionhunter:
    input:
        unpack(wf.get_input_files("expansionhunter", "annotate")),
    output:
        **wf.get_output_files("expansionhunter", "annotate"),
    threads: wf.get_resource("expansionhunter", "annotate", "threads")
    resources:
        **wf.get_resources("expansionhunter", "annotate"),
    run:
        wf.sub_steps["expansionhunter"].annotate_results(wildcards, input, output)
