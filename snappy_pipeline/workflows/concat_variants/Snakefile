from snappy_pipeline.orchestration import task_instance

# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


rule concat_variants_all:
    default_target: True
    input:
        wf.get_result_files(),


rule concat_variants_bcftools_run:
    input:
        unpack(wf.get_input_files("bcftools", "run")),
    output:
        **wf.get_output_files("bcftools", "run"),
    log:
        **wf.get_log_file("bcftools", "run"),
    benchmark:
        wf.get_benchmark_file("bcftools", "run")
    threads: wf.get_resource("bcftools", "run", "threads")
    resources:
        runtime=wf.get_resource("bcftools", "run", "runtime"),
        mem=wf.get_resource("bcftools", "run", "mem"),
        partition=wf.get_resource("bcftools", "run", "partition"),
        tmpdir=wf.get_resource("bcftools", "run", "tmpdir"),
    params:
        args=wf.get_params("bcftools", "run"),
    wrapper:
        wf.wrapper_path("bcftools/concat_variants")


if "calls_report" in wf.sub_steps:

    rule concat_variants_calls_report:
        input:
            unpack(wf.get_input_files("calls_report", "run")),
        output:
            **wf.get_output_files("calls_report", "run"),
        log:
            **wf.get_log_file("calls_report", "run"),
        benchmark:
            wf.get_benchmark_file("calls_report", "run")
        threads: wf.get_resource("calls_report", "run", "threads")
        resources:
            runtime=wf.get_resource("calls_report", "run", "runtime"),
            mem=wf.get_resource("calls_report", "run", "mem"),
            partition=wf.get_resource("calls_report", "run", "partition"),
            tmpdir=wf.get_resource("calls_report", "run", "tmpdir"),
        params:
            args=wf.get_params("calls_report", "run"),
        wrapper:
            wf.wrapper_path("calls_report")
