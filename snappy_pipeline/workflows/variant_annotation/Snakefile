# -*- coding: utf-8 -*-
"""SNAPPY Pipeline variant_annotation step Snakefile"""

from snappy_pipeline.workflows.variant_annotation.model import Tool
from snappy_pipeline.orchestration import task_instance

__author__ = "Manuel Holtgrewe <manuel.holtgrewe@bihealth.de>"


# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


# Rules =======================================================================


localrules:
    # Linking files from work/ to output/ should be done locally.
    variant_annotation_link_out_run,


rule variant_annotation_all:
    default_target: True
    input:
        wf.get_result_files(),


# House-Keeping ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~


rule variant_annotation_link_out_run:
    input:
        wf.get_input_files("link_out", "run"),
    output:
        wf.get_output_files("link_out", "run"),
    run:
        wf.run_locally("link_out", "run", wildcards)


# Variant Annotation ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

if wf.config.tool == Tool.vep:

    rule variant_annotation_vep:
        input:
            unpack(wf.get_input_files("vep", "run")),
        output:
            **wf.get_output_files("vep", "run"),
        log:
            **wf.get_log_file("vep", "run"),
        benchmark:
            wf.get_benchmark_file("vep", "run")
        threads: wf.get_resource("vep", "run", "threads")
        resources:
            runtime=wf.get_resource("vep", "run", "runtime"),
            mem=wf.get_resource("vep", "run", "mem"),
            partition=wf.get_resource("vep", "run", "partition"),
            tmpdir=wf.get_resource("vep", "run", "tmpdir"),
        params:
            args=wf.get_params("vep", "run"),
        wrapper:
            wf.wrapper_path("vep/run")

elif wf.config.tool == Tool.mehari:

    rule variant_annotation_mehari:
        input:
            unpack(wf.get_input_files("mehari", "run")),
        output:
            **wf.get_output_files("mehari", "run"),
        log:
            **wf.get_log_file("mehari", "run"),
        benchmark:
            wf.get_benchmark_file("mehari", "run")
        threads: wf.get_resource("mehari", "run", "threads")
        resources:
            runtime=wf.get_resource("mehari", "run", "runtime"),
            mem=wf.get_resource("mehari", "run", "mem"),
            partition=wf.get_resource("mehari", "run", "partition"),
            tmpdir=wf.get_resource("mehari", "run", "tmpdir"),
        params:
            args=wf.get_params("mehari", "run"),
        wrapper:
            wf.wrapper_path("mehari/run")

else:
    raise ValueError(f"unknown tool {wf.config.tool}")
