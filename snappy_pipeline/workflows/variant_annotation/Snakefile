# -*- coding: utf-8 -*-
"""SNAPPY Pipeline variant_annotation step Snakefile"""

import os

from snappy_pipeline import expand_ref
from snappy_pipeline.workflows.variant_annotation import VariantAnnotationWorkflow

__author__ = "Manuel Holtgrewe <manuel.holtgrewe@bihealth.de>"


# Configuration ===============================================================


configfile: "config.yaml"


# Expand "$ref" JSON pointers in configuration (also works for YAML)
config, lookup_paths, config_paths = expand_ref("config.yaml", config)

# WorkflowImpl Object Setup ===================================================

wf = VariantAnnotationWorkflow(workflow, config, lookup_paths, config_paths, os.getcwd())


# Modules =====================================================================


target_upstream = wf.depends_on.get("variant_calling", "variant_calling")
upstream_prefix = wf.config.get(f"path_variant_calling", f"../{target_upstream}")


module variant_calling:
    snakefile:
        "../variant_calling/Snakefile"
    config:
        wf.w_config
    prefix:
        upstream_prefix


use rule * from variant_calling as variant_calling_*


target_upstream = wf.depends_on.get("ngs_mapping", "ngs_mapping")
upstream_prefix = wf.config.get(f"path_ngs_mapping", f"../{target_upstream}")


module ngs_mapping:
    snakefile:
        "../ngs_mapping/Snakefile"
    config:
        wf.w_config
    prefix:
        upstream_prefix


use rule * from ngs_mapping as ngs_mapping_*


# Rules =======================================================================


rule variant_annotation_all:
    default_target: True
    input:
        wf.get_result_files(),


# House-Keeping ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Variant Annotation ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Run VEP ---------------------------------------------------------------------


rule variant_annotation_vep_run:
    input:
        **wf.get_input_files("vep", "run"),
    output:
        **wf.get_output_files("vep", "run"),
    log:
        **wf.get_log_file("vep", "run"),
    threads: wf.get_resource("vep", "run", "threads")
    resources:
        runtime=wf.get_resource("vep", "run", "runtime"),
        mem=wf.get_resource("vep", "run", "mem"),
        partition=wf.get_resource("vep", "run", "partition"),
        tmpdir=wf.get_resource("vep", "run", "tmpdir"),
    params:
        args=wf.get_args("vep", "run"),
    wrapper:
        wf.wrapper_path("vep")
