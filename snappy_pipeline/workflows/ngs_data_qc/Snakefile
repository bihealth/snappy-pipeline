            wf.get_benchmark_file("ngs_chew", "compare")
        threads: wf.get_resource("ngs_chew", "compare", "threads")
        resources:
            runtime=wf.get_resource("ngs_chew", "compare", "runtime"),
            mem=wf.get_resource("ngs_chew", "compare", "mem"),
            partition=wf.get_resource("ngs_chew", "compare", "partition"),
