# -*- coding: utf-8 -*-
"""CUBI Pipeline hla_typing step Snakefile"""

from snappy_pipeline.orchestration import task_instance

__author__ = "Manuel Holtgrewe <manuel.holtgrewe@bihealth.de>"


# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])

# Rules =======================================================================


# HLA Typing ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# OptiType --------------------------------------------------------------------


if wf.config.tool == "optitype":

    rule hla_typing_optitype_run:
        input:
            unpack(wf.get_input_files("optitype", "run")),
        output:
            **wf.get_output_files("optitype", "run"),
        log:
            **wf.get_log_file("optitype", "run"),
        benchmark:
            wf.get_benchmark_file("optitype", "run")
        threads: wf.get_resource("optitype", "run", "threads")
        resources:
            **wf.get_resources("optitype", "run"),
        params:
            args=wf.get_params("optitype", "run"),
        wrapper:
            wf.get_wrapper("optitype", "run")


# arcasHLA --------------------------------------------------------------------


if wf.config.tool == "arcashla":

    rule hla_typing_arcashla_prepare_reference:
        output:
            **wf.get_output_files("arcashla", "prepare_reference"),
        log:
            **wf.get_log_file("arcashla", "prepare_reference"),
        benchmark:
            wf.get_benchmark_file("arcashla", "prepare_reference")
        # Network access: downloads and installs fail now and then
        retries: 2
        threads: wf.get_resource("arcashla", "prepare_reference", "threads")
        resources:
            **wf.get_resources("arcashla", "prepare_reference"),
        params:
            args=wf.get_params("arcashla", "prepare_reference"),
        wrapper:
            wf.get_wrapper("arcashla", "prepare_reference")

    rule hla_typing_arcashla_run:
        input:
            unpack(wf.get_input_files("arcashla", "run")),
        output:
            **wf.get_output_files("arcashla", "run"),
        log:
            **wf.get_log_file("arcashla", "run"),
        benchmark:
            wf.get_benchmark_file("arcashla", "run")
        threads: wf.get_resource("arcashla", "run", "threads")
        resources:
            **wf.get_resources("arcashla", "run"),
        params:
            args=wf.get_params("arcashla", "run"),
        wrapper:
            wf.get_wrapper("arcashla", "run")
