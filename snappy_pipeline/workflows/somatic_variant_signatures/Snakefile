# -*- coding: utf-8 -*-
"""CUBI Pipeline somatic_variant_signatures step Snakefile"""

from snappy_pipeline.orchestration import task_instance

__author__ = "Clemens Messerschmidt"


# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


# Rules =======================================================================


# House-Keeping ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Somatic variant signatures ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Tabulate VCF ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~


rule somatic_variant_signatures_tabulate_vcf:
    input:
        unpack(wf.get_input_files("tabulate_vcf", "run")),
    output:
        **wf.get_output_files("tabulate_vcf", "run"),
    log:
        **wf.get_log_file("tabulate_vcf", "run"),
    benchmark:
        wf.get_benchmark_file("tabulate_vcf", "run")
    threads: wf.get_resource("tabulate_vcf", "run", "threads")
    resources:
        **wf.get_resources("tabulate_vcf", "run"),
    params:
        args=wf.get_params("tabulate_vcf", "run"),
    wrapper:
        wf.get_wrapper("tabulate_vcf", "run")


# Run R deconstructSigs ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~


rule somatic_variant_signatures_deconstructsigs:
    input:
        unpack(wf.get_input_files("deconstruct_sigs", "run")),
    output:
        **wf.get_output_files("deconstruct_sigs", "run"),
    log:
        **wf.get_log_file("deconstruct_sigs", "run"),
    benchmark:
        wf.get_benchmark_file("deconstruct_sigs", "run")
    threads: wf.get_resource("deconstruct_sigs", "run", "threads")
    resources:
        **wf.get_resources("deconstruct_sigs", "run"),
    params:
        args=wf.get_params("deconstruct_sigs", "run"),
    wrapper:
        wf.get_wrapper("deconstruct_sigs", "run")
