    resources:
        runtime=wf.get_resource("ascat", "run_ascat", "runtime"),
        mem=wf.get_resource("ascat", "run_ascat", "mem"),
        partition=wf.get_resource("ascat", "run_ascat", "partition"),
        tmpdir=wf.get_resource("ascat", "run_ascat", "tmpdir"),
    params:
        args=wf.get_params("ascat", "run_ascat"),
    wrapper:
        wf.wrapper_path("ascat/run_ascat")
