        runtime=wf.get_resource("ascat", "cnv_tumor", "runtime"),
        mem=wf.get_resource("ascat", "cnv_tumor", "mem"),
        partition=wf.get_resource("ascat", "cnv_tumor", "partition"),
        tmpdir=wf.get_resource("ascat", "cnv_tumor", "tmpdir"),
    params:
        args=wf.get_params("ascat", "cnv_tumor"),
    wrapper:
        wf.wrapper_path("ascat/build_cnv")


