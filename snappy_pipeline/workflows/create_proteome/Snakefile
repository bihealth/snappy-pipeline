from snappy_pipeline.orchestration import task_instance

# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


rule create_proteome_link_out_run:
    input:
        wf.get_input_files("link_out", "run"),
    output:
        wf.get_output_files("link_out", "run"),
    localrule: True
    run:
        wf.sub_steps["link_out"].run_locally("run", wildcards)


rule create_proteome_run:
    input:
        unpack(wf.get_input_files("create_proteome", "run")),
    output:
        **wf.get_output_files("create_proteome", "run"),
    log:
        **wf.get_log_file("create_proteome", "run"),
    benchmark:
        wf.get_benchmark_file("create_proteome", "run")
    threads: wf.get_resource("create_proteome", "run", "threads")
    resources:
        **wf.get_resources("create_proteome", "run"),
    params:
        args=wf.get_params("create_proteome", "run"),
    wrapper:
        wf.get_wrapper("create_proteome", "run")
