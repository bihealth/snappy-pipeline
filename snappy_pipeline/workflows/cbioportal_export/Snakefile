# -*- coding: utf-8 -*-
"""CUBI Pipeline cbioportal_export step Snakefile"""

import csv
from snappy_pipeline.orchestration import task_instance

__author__ = "Clemens Messerschmidt"

# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


include: "../common/wrapper_rules.rules"


step_config = wf.get_task_config("cbioportal_export")
exclude_flag = step_config.exclude_variant_with_flag


# cbioportal study metadata ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~


rule cbioportal_export_meta_files:
    output:
        wf.get_output_files("cbioportal_meta_files", "run"),
    log:
        **wf.get_log_file("cbioportal_meta_files", "run"),
    benchmark:
        wf.get_benchmark_file("cbioportal_meta_files", "run")
    localrule: True
    params:
        args=wf.get_params("cbioportal_meta_files", "run"),
    wrapper:
        wf.get_wrapper("cbioportal_meta_files", "run")


# Merge all sample MAF files --------------------------------------------------


rule cbioportal_export_concatenate_maf:
    input:
        unpack(wf.get_input_files("cbioportal_mutations", "run")),
    output:
        wf.get_output_files("cbioportal_mutations", "run"),
    localrule: True
    params:
        exclude_flag=wf.config.exclude_variant_with_flag,
    shell:
        r"""
        cat \
        <( head -n 1 {input[0]} ) \
        <( tail -q -n +2 {input}) \
        | (if [[ -n {params.exclude_flag:q} ]] ; then grep -v {params.exclude_flag:q} ; else cat ; fi) \
        > {output}
        """


# Copy number files (data_cna_log2.txt, data_cna_gistic.txt, data_segment.txt)

if step_config.copy_number_alteration.enabled:

    # Create CNA files (discrete, continuous from cns files) ----------------------

    # Merge sample-based CNA files to cBioPortal ----------------------------------
    rule cbioportal_export_concatenate_cna_log2:
        input:
            unpack(wf.get_input_files("cbioportal_cna", "log2")),
        output:
            wf.get_output_files("cbioportal_cna", "log2"),
        log:
            **wf.get_log_file("cbioportal_cna", "log2"),
        benchmark:
            wf.get_benchmark_file("cbioportal_cna", "log2")
        threads: wf.get_resource("cbioportal_cna", "log2", "threads")
        resources:
            **wf.get_resources("cbioportal_cna", "log2"),
        params:
            args=wf.get_params("cbioportal_cna", "log2"),
        wrapper:
            wf.get_wrapper("cbioportal_cna", "log2")

    rule cbioportal_export_concatenate_cna_gistic:
        input:
            unpack(wf.get_input_files("cbioportal_cna", "gistic")),
        output:
            wf.get_output_files("cbioportal_cna", "gistic"),
        log:
            **wf.get_log_file("cbioportal_cna", "gistic"),
        benchmark:
            wf.get_benchmark_file("cbioportal_cna", "gistic")
        threads: wf.get_resource("cbioportal_cna", "gistic", "threads")
        resources:
            **wf.get_resources("cbioportal_cna", "gistic"),
        params:
            args=wf.get_params("cbioportal_cna", "gistic"),
        wrapper:
            wf.get_wrapper("cbioportal_cna", "gistic")

    # Merge sample-based segment files to cBioPortal ------------------------------
    rule cbioportal_export_concatenate_segments:
        input:
            unpack(wf.get_input_files("cbioportal_segment", "run")),
        output:
            wf.get_output_files("cbioportal_segment", "run"),
        log:
            **wf.get_log_file("cbioportal_segment", "run"),
        benchmark:
            wf.get_benchmark_file("cbioportal_segment", "run")
        threads: wf.get_resource("cbioportal_segment", "run", "threads")
        resources:
            **wf.get_resources("cbioportal_segment", "run"),
        params:
            args=wf.get_params("cbioportal_segment", "run"),
        wrapper:
            wf.get_wrapper("cbioportal_segment", "run")


# Create expression RPKMs -----------------------------------------------------

if step_config.expression.enabled:

    rule cbioportal_export_expression:
        input:
            unpack(wf.get_input_files("cbioportal_expression", "run")),
        output:
            wf.get_output_files("cbioportal_expression", "run"),
        log:
            **wf.get_log_file("cbioportal_expression", "run"),
        benchmark:
            wf.get_benchmark_file("cbioportal_expression", "run")
        threads: wf.get_resource("cbioportal_expression", "run", "threads")
        resources:
            **wf.get_resources("cbioportal_expression", "run"),
        params:
            args=wf.get_params("cbioportal_expression", "run"),
        wrapper:
            wf.get_wrapper("cbioportal_expression", "run")
