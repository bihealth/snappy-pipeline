# -*- coding: utf-8 -*-
"""CUBI Pipeline tumor mutational burden step Snakefile"""

from snappy_pipeline.orchestration import task_instance

__author__ = ""


# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


# Rules =======================================================================


rule tumor_mutational_burden_calculation:
    input:
        unpack(wf.get_input_files("tmb_gathering", "run")),
    output:
        **wf.get_output_files("tmb_gathering", "run"),
    log:
        **wf.get_log_file("tmb_gathering", "run"),
    benchmark:
        wf.get_benchmark_file("tmb_gathering", "run")
    threads: wf.get_resource("tmb_gathering", "run", "threads")
    resources:
        **wf.get_resources("tmb_gathering", "run"),
    params:
        args=wf.get_params("tmb_gathering", "run"),
    wrapper:
        wf.get_wrapper("tmb_gathering", "run")
