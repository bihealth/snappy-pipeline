# -*- coding: utf-8 -*-
"""CUBI Pipeline gcnv_model step Snakefile"""

from snappy_pipeline.orchestration import task_instance

# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


# Rules =======================================================================


rule gcnv_model_write_pedigree_run:
    output:
        wf.get_output_files("write_pedigree", "run"),
    localrule: True
    params:
        args=wf.get_params("write_pedigree", "run"),
    run:
        wf.sub_steps["write_pedigree"].write(params.args, output)


rule gcnv_model_preprocess_intervals:
    input:
        unpack(wf.get_input_files("gcnv", "preprocess_intervals")),
    output:
        **wf.get_output_files("gcnv", "preprocess_intervals"),
    log:
        **wf.get_log_file("gcnv", "preprocess_intervals"),
    benchmark:
        wf.get_benchmark_file("gcnv", "preprocess_intervals")
    threads: wf.get_resource("gcnv", "preprocess_intervals", "threads")
    resources:
        **wf.get_resources("gcnv", "preprocess_intervals"),
    params:
        args=wf.get_params("gcnv", "preprocess_intervals"),
    wrapper:
        wf.get_wrapper("gcnv", "preprocess_intervals")


