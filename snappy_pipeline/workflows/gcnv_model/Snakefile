# -*- coding: utf-8 -*-
"""CUBI Pipeline gcnv_model step Snakefile"""

from snappy_pipeline.orchestration import task_instance

# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


include: "../common/wrapper_rules.rules"


# Rules =======================================================================


rule gcnv_model_write_pedigree_run:
    output:
        wf.get_output_files("write_pedigree", "run"),
    localrule: True
    params:
        args=wf.get_params("write_pedigree", "run"),
    run:
        wf.sub_steps["write_pedigree"].write(params.args, output)


def gcnv_model_post_germline_calls_input(wildcards):
    return wf.get_input_files("gcnv", "post_germline_calls")(wildcards, checkpoints)


checkpoint gcnv_model_scatter_intervals:
    input:
        unpack(wf.get_input_files("gcnv", "scatter_intervals")),
    output:
        directory(wf.get_output_files("gcnv", "scatter_intervals")),
    log:
        **wf.get_log_file("gcnv", "scatter_intervals"),
    benchmark:
        wf.get_benchmark_file("gcnv", "scatter_intervals")
    threads: wf.get_resource("gcnv", "scatter_intervals", "threads")
    resources:
        **wf.get_resources("gcnv", "scatter_intervals"),
    params:
        args=wf.get_params("gcnv", "scatter_intervals"),
    wrapper:
        wf.get_wrapper("gcnv", "scatter_intervals")


# The input function takes the checkpoints object, so the include cannot write this rule
rule gcnv_model_gcnv_post_germline_calls:
    input:
        unpack(gcnv_model_post_germline_calls_input),
    output:
        **wf.get_output_files("gcnv", "post_germline_calls"),
    log:
        **wf.get_log_file("gcnv", "post_germline_calls"),
    benchmark:
        wf.get_benchmark_file("gcnv", "post_germline_calls")
    threads: wf.get_resource("gcnv", "post_germline_calls", "threads")
    resources:
        **wf.get_resources("gcnv", "post_germline_calls"),
    params:
        args=wf.get_params("gcnv", "post_germline_calls"),
    wrapper:
        wf.get_wrapper("gcnv", "post_germline_calls")
