# -*- coding: utf-8 -*-
"""CUBI Pipeline reference_index step Snakefile"""

from snappy_pipeline.orchestration import task_instance

# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


rule reference_index_common_run:
    input:
        unpack(wf.get_input_files("common", "run")),
    output:
        **wf.get_output_files("common", "run"),
    log:
        **wf.get_log_file("common", "run"),
    cache: "omit-software"
    localrule: True
    threads: wf.get_resource("common", "run", "threads")
    resources:
        **wf.get_resources("common", "run"),
    params:
        args=wf.get_params("common", "run"),
    wrapper:
        wf.get_wrapper("common", "run")


tool = str(wf.config.tool)
