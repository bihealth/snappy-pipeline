# -*- coding: utf-8 -*-
"""CUBI Pipeline variant_filtration step Snakefile"""

from snappy_pipeline.orchestration import task_instance

__author__ = "Manuel Holtgrewe <manuel.holtgrewe@bih-charite.de>"


# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


# Rules =======================================================================


# Special local rule for ebfilter write_panel (only active when tool=ebfilter)
if wf.config.tool == "ebfilter":

    rule variant_filtration_ebfilter_write_panel:
        output:
            **wf.get_output_files("filter", "write_panel"),
        localrule: True
        threads: wf.get_resource("filter", "write_panel", "threads")
        resources:
            **wf.get_resources("filter", "write_panel"),
        params:
            args=wf.get_params("filter", "write_panel"),
        run:
            wf.sub_steps["filter"].write_panel_of_normals_file(wildcards)


# Variant Filtration ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~


rule variant_filtration_filter_run:
    input:
        unpack(wf.get_input_files("filter", "run")),
    output:
        **wf.get_output_files("filter", "run"),
    log:
        **wf.get_log_file("filter", "run"),
    benchmark:
        wf.get_benchmark_file("filter", "run")
    threads: wf.get_resource("filter", "run", "threads")
    resources:
        **wf.get_resources("filter", "run"),
    params:
        args=wf.get_params("filter", "run"),
    wrapper:
        wf.get_wrapper("filter", "run")


if "calls_report" in wf.sub_steps:

    rule variant_filtration_calls_report:
        input:
            unpack(wf.get_input_files("calls_report", "run")),
        output:
            **wf.get_output_files("calls_report", "run"),
        log:
            **wf.get_log_file("calls_report", "run"),
        benchmark:
            wf.get_benchmark_file("calls_report", "run")
        threads: wf.get_resource("calls_report", "run", "threads")
        resources:
            **wf.get_resources("calls_report", "run"),
        params:
            args=wf.get_params("calls_report", "run"),
        wrapper:
            wf.get_wrapper("calls_report", "run")
