# -*- coding: utf-8 -*-
"""CUBI Pipeline wgs_sv_export_external step Snakefile"""

from snappy_pipeline.orchestration import task_instance

# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])


include: "../common/wrapper_rules.rules"


# Write out pedigree file -----------------------------------------------------


rule write_pedigree_run:
    output:
        wf.get_output_files("write_pedigree_with_sample_name", "run"),
    localrule: True
    params:
        args=wf.get_params("write_pedigree_with_sample_name", "run"),
    run:
        wf.sub_steps["write_pedigree_with_sample_name"].write(params.args, output)
