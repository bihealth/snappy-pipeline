# -*- coding: utf-8 -*-
"""CUBI Pipeline variant_calling step Snakefile"""

from snappy_pipeline.orchestration import task_instance

__author__ = "Manuel Holtgrewe <manuel.holtgrewe@bihealth.de>"


# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])
tool = str(wf.config.tool)

# Rules =======================================================================


wildcard_constraints:
    library_name="[^/.]+",
    member="[^/.]+",


# Variant Calling ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Write out pedigree file -----------------------------------------------------


rule variant_calling_write_pedigree_run:
    input:
        unpack(wf.get_input_files("write_pedigree", "run")),
    output:
        wf.get_output_files("write_pedigree", "run"),
    localrule: True
    params:
        args=wf.get_params("write_pedigree", "run"),
    run:
        wf.sub_steps["write_pedigree"].write(params.args, output)


# Run bcftools call -----------------------------------------------------------

if tool == "bcftools_call":

    rule variant_calling_bcftools_call_run:
        input:
            unpack(wf.get_input_files("bcftools_call", "run")),
        output:
            **wf.get_output_files("bcftools_call", "run"),
        log:
            **wf.get_log_file("bcftools_call", "run"),
        benchmark:
            wf.get_benchmark_file("bcftools_call", "run")
        threads: wf.get_resource("bcftools_call", "run", "threads")
        resources:
            **wf.get_resources("bcftools_call", "run"),
        params:
            args=wf.get_params("bcftools_call", "run"),
        wrapper:
            wf.get_wrapper("bcftools_call", "run")


# Run GATK HaplotypeCaller (direct, pedigree/multi-sample) --------------------


elif tool == "gatk3_hc":

    rule variant_calling_gatk3_hc_run:
