# Run MuTect 2 ----------------------------------------------------------------

if tool == "mutect2":

    if (
        getattr(wf.config.mutect2, "contamination", None)
        and wf.config.mutect2.contamination.enabled
    ):

        rule variant_calling_mutect2_pileup_normal:
            input:
                unpack(wf.get_input_files("mutect2", "pileup_normal")),
            output:
