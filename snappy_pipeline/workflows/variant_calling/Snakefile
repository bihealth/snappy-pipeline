            output:
                **wf.get_output_files("mutect2", "contamination"),
            log:
                **wf.get_log_file("mutect2", "contamination"),
            benchmark:
                wf.get_benchmark_file("mutect2", "contamination")
            threads: wf.get_resource("mutect2", "contamination", "threads")
            resources:
                **wf.get_resources("mutect2", "contamination"),
            params:
                args=wf.get_params("mutect2", "contamination"),
            wrapper:
                wf.get_wrapper("mutect2", "contamination")

    scattergather:
        mutect2=(
            getattr(wf.config.mutect2, "num_jobs", 24)
            if getattr(wf.config, "mutect2", None)
            else 24
        ),

    rule variant_calling_mutect2_scatter:
        input:
            unpack(wf.get_input_files("mutect2", "scatter")),
        output:
            **wf.get_output_files("mutect2", "scatter"),
        log:
            **wf.get_log_file("mutect2", "scatter"),
        benchmark:
            wf.get_benchmark_file("mutect2", "scatter")
        localrule: True
        threads: 1
        resources:
            **wf.get_resources("mutect2", "scatter"),
        params:
            args=wf.get_params("mutect2", "scatter"),
        wrapper:
            wf.get_wrapper("mutect2", "scatter")

    rule variant_calling_mutect2_run:
        input:
            unpack(wf.get_input_files("mutect2", "run")),
        output:
            **wf.get_output_files("mutect2", "run"),
        log:
            **wf.get_log_file("mutect2", "run"),
        benchmark:
            wf.get_benchmark_file("mutect2", "run")
        threads: wf.get_resource("mutect2", "run", "threads")
        resources:
            **wf.get_resources("mutect2", "run"),
        params:
            args=wf.get_params("mutect2", "run"),
        wrapper:
            wf.get_wrapper("mutect2", "run")

    rule variant_calling_mutect2_gather:
