# -*- coding: utf-8 -*-
"""The rules of the tools that ``sv_calling_targeted`` and ``sv_calling_wgs`` share.

The including Snakefile defines ``wf`` and ``tool``; the rules of the wrapper actions come from
``common/wrapper_rules.rules``, these are the ``run:`` rules and the gCNV checkpoint.
"""

# Write out pedigree file -----------------------------------------------------


rule:
    name:
        f"{wf.name}_write_pedigree_run"
    output:
        wf.get_output_files("write_pedigree", "run"),
    localrule: True
    params:
        args=wf.get_params("write_pedigree", "run"),
    run:
        wf.sub_steps["write_pedigree"].write(params.args, output)


# Structural Variant Calling ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~


if tool == "gcnv":

    # GATK-gCNV ----------------------------------------------------------------

    # The shards of the model are known after the checkpoint of the model task. A module cannot
    # use the checkpoints of another one, so this local checkpoint lists them for this task.

    checkpoint:
        name:
            f"{wf.name}_gcnv_shards"
        input:
            unpack(wf.get_input_files("gcnv", "shards")),
        output:
            **wf.get_output_files("gcnv", "shards"),
        localrule: True
        run:
            wf.sub_steps["gcnv"].write_shards(input, output)

    def gcnv_post_germline_calls_input(wildcards):
        return wf.get_input_files("gcnv", "post_germline_calls")(wildcards, checkpoints)

    # The input function takes the checkpoints object, so the include cannot write this rule
    rule:
        name:
            f"{wf.name}_gcnv_post_germline_calls"
        input:
            unpack(gcnv_post_germline_calls_input),
        output:
            **wf.get_output_files("gcnv", "post_germline_calls"),
        log:
            **wf.get_log_file("gcnv", "post_germline_calls"),
        benchmark:
            wf.get_benchmark_file("gcnv", "post_germline_calls")
        threads: wf.get_resource("gcnv", "post_germline_calls", "threads")
        resources:
            **wf.get_resources("gcnv", "post_germline_calls"),
        params:
            args=wf.get_params("gcnv", "post_germline_calls"),
        wrapper:
            wf.get_wrapper("gcnv", "post_germline_calls")
