# The rules of the somatic CNVkit calling (snappy_pipeline/workflows/common/cnvkit.py), which the
# somatic CNV calling steps include; named after the step, like their other rules


for action in wf.sub_steps["cnvkit"].actions:

    rule:
        name:
            f"{wf.name}_cnvkit_{action}"
        input:
            unpack(wf.get_input_files("cnvkit", action)),
        output:
            **wf.get_output_files("cnvkit", action),
        log:
            **wf.get_log_file("cnvkit", action),
        benchmark:
            wf.get_benchmark_file("cnvkit", action)
        threads: wf.get_resource("cnvkit", action, "threads")
        resources:
            **wf.get_resources("cnvkit", action),
        params:
            args=wf.get_params("cnvkit", action),
        wrapper:
            wf.get_wrapper("cnvkit", action)
