# -*- coding: utf-8 -*-
"""CUBI Pipeline panel_of_normals step Snakefile"""

from snappy_pipeline.orchestration import task_instance

__author__ = "Manuel Holtgrewe <manuel.holtgrewe@bihealth.de>"


# The software directives are in fmt: off regions, because snakefmt does not know them yet

# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])
tool = str(wf.config.tool)


# Rules =======================================================================


# House-Keeping ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Panel of normals (Mutect2) ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Write out the tumor-only results for the normals ----------------------------

if tool == "mutect2":

    scattergather:
        mutect2=wf.config.mutect2.num_jobs,

    rule panel_of_normals_mutect2_scatter:
        input:
            unpack(wf.get_input_files("mutect2", "scatter")),
        output:
            **wf.get_output_files("mutect2", "scatter"),
        log:
            **wf.get_log_file("mutect2", "scatter"),
        benchmark:
            wf.get_benchmark_file("mutect2", "scatter")
        localrule: True
        threads: 1
        resources:
            **wf.get_resources("mutect2", "scatter"),
        params:
            args=wf.get_params("mutect2", "scatter"),
        wrapper:
            wf.get_wrapper("mutect2", "scatter")

    rule panel_of_normals_mutect2_prepare_panel:
        input:
            unpack(wf.get_input_files("mutect2", "prepare_panel")),
        output:
            **wf.get_output_files("mutect2", "prepare_panel"),
        log:
            **wf.get_log_file("mutect2", "prepare_panel"),
        benchmark:
            wf.get_benchmark_file("mutect2", "prepare_panel")
        threads: wf.get_resource("mutect2", "prepare_panel", "threads")
        resources:
            **wf.get_resources("mutect2", "prepare_panel"),
        params:
            args=wf.get_params("mutect2", "prepare_panel"),
        wrapper:
            wf.get_wrapper("mutect2", "prepare_panel")

    rule panel_of_normals_mutect2_gather:
        input:
            unpack(wf.get_input_files("mutect2", "gather")),
        output:
            **wf.get_output_files("mutect2", "gather"),
        log:
            **wf.get_log_file("mutect2", "gather"),
        benchmark:
            wf.get_benchmark_file("mutect2", "gather")
        threads: 1
        resources:
            **wf.get_resources("mutect2", "gather"),
        params:
            args=wf.get_params("mutect2", "gather"),
        wrapper:
            wf.get_wrapper("mutect2", "gather")

    rule panel_of_normals_mutect2_create_panel:
        input:
            unpack(wf.get_input_files("mutect2", "create_panel")),
        output:
            **wf.get_output_files("mutect2", "create_panel"),
        log:
            **wf.get_log_file("mutect2", "create_panel"),
        benchmark:
            wf.get_benchmark_file("mutect2", "create_panel")
        threads: wf.get_resource("mutect2", "create_panel", "threads")
