# -*- coding: utf-8 -*-
"""CUBI Pipeline panel_of_normals step Snakefile"""

from snappy_pipeline.orchestration import task_instance

__author__ = "Manuel Holtgrewe <manuel.holtgrewe@bihealth.de>"


# WorkflowImpl Object Setup ===================================================

wf = task_instance(config["__task_name__"])
tool = str(wf.config.tool)


# Write out the tumor-only results for the normals ----------------------------

if tool == "mutect2":

    scattergather:
        mutect2=wf.config.mutect2.num_jobs,


include: "../common/wrapper_rules.rules"


# Panel of normals (PureCN) ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

if tool == "purecn":

    rule purecn_prepare:
        input:
            unpack(wf.get_input_files("purecn", "prepare")),
        output:
            **wf.get_output_files("purecn", "prepare"),
        log:
            **wf.get_log_file("purecn", "prepare"),
        benchmark:
            wf.get_benchmark_file("purecn", "prepare")
        resources:
            **wf.get_resources("purecn", "prepare"),
        params:
            args=wf.get_params("purecn", "prepare"),
        # fmt: off
        software:
            container(image_uri=wf.config.purecn.container)
        # fmt: on
        wrapper:
            wf.get_wrapper("purecn", "prepare")

    rule purecn_coverage:
        input:
            unpack(wf.get_input_files("purecn", "coverage")),
        output:
            **wf.get_output_files("purecn", "coverage"),
        log:
            **wf.get_log_file("purecn", "coverage"),
        benchmark:
            wf.get_benchmark_file("purecn", "coverage")
        resources:
            **wf.get_resources("purecn", "coverage"),
        params:
            args=wf.get_params("purecn", "coverage"),
        # fmt: off
        software:
            container(image_uri=wf.config.purecn.container)
        # fmt: on
        wrapper:
            wf.get_wrapper("purecn", "coverage")

    rule purecn_create_panel:
        input:
            unpack(wf.get_input_files("purecn", "create_panel")),
        output:
            **wf.get_output_files("purecn", "create_panel"),
        log:
            **wf.get_log_file("purecn", "create_panel"),
        benchmark:
            wf.get_benchmark_file("purecn", "create_panel")
        resources:
            **wf.get_resources("purecn", "create_panel"),
        params:
            args=wf.get_params("purecn", "create_panel"),
        # fmt: off
        software:
            container(image_uri=wf.config.purecn.container)
        # fmt: on
        wrapper:
            wf.get_wrapper("purecn", "create_panel")
