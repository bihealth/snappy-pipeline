import os
from snappy_pipeline.orchestration import (
    ON_HOLD_STEPS,
    create_task_instances,
    load_project,
    register_hooks,
    select_target_tasks,
)
from snappy_pipeline.publish import MANIFEST, publish, work_paths
from snappy_pipeline.sheet_summary import print_library_summary

configfile: "config.yaml"

# Relative paths in the configuration are relative to the directory of the config file, even
# when Snakemake runs in another directory (`snappy run` passes the file as --configfile)
project = load_project(config, os.path.dirname(os.path.abspath(workflow.configfiles[0])))

# Targeting mode:
#   default          - every task builds and publishes its result files
#   config["task"]   - only the named task; upstream tasks run as far as it needs them
#   config["frozen"] - with "task": load only that task's rules; upstream outputs are inputs
target_task = config.get("task")
frozen = bool(config.get("frozen", False))
target_task_names = select_target_tasks(project, target_task)
module_task_names = target_task_names if frozen else [task.name for task in project.tasks]
task_instances = create_task_instances(workflow, project, module_task_names)
register_hooks(workflow)

if target_task:
    _mode_desc = f"single task '{target_task}'" + (" (frozen upstream)" if frozen else "")
else:
    _mode_desc = "all tasks"

print(f"[snappy] Targeting {_mode_desc}", flush=True)

# Once per run, not again in each cluster job
if workflow.is_main_process:
    print_library_summary(task_instances)

for task in project.model.tasks:
    if task.name not in module_task_names:
        continue
    t_name = task.name
    t_step = task.step
    alias = t_name + "_"
    # Each task writes below tasks/<name>/
    prefixes = {d: f"tasks/{t_name}/{d}" for d in ("output/", "work/", "benchmarks/")}

    module:
        name: t_name
        snakefile: f"workflows/{t_step}/Snakefile"
        config: {"__task_name__": t_name}
        replace_prefix: prefixes

    use rule * from t_name as alias*

# One local job per targeted task links its result files from work/ into output/
targets = []
for t_name in target_task_names:
    result_files = list(task_instances[t_name].get_result_files())
    if project.task(t_name).step in ON_HOLD_STEPS:
        targets += [f"tasks/{t_name}/{f}" for f in result_files if not f.endswith((".md5", ".tbi"))]
        continue
    if not result_files:
        continue
    targets.append(f"tasks/{t_name}/output/{MANIFEST}")

    rule:
        name:
            f"{t_name}_publish"
        input:
            [f"tasks/{t_name}/{path}" for path in work_paths(result_files)]
        output:
            targets[-1]
        params:
            task_dir=f"tasks/{t_name}"
        localrule: True
        run:
            publish(params.task_dir, list(input), output[0])

rule all:
    input:
        targets
    default_target: True
