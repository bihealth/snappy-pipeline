import tempfile
import os
from snappy_pipeline.workflow_registry import WORKFLOW_REGISTRY
from snappy_pipeline import expand_ref


configfile: "config.yaml"


config, config_lookup_paths, config_paths = expand_ref("config.yaml", config)

tasks = config.get("tasks", [])
all_target_files = []
dsl_lines = []

target_task = config.get("task")

for task in tasks:
    task_name = task["name"]
    step_type = task["step"]

    wf_instance = WORKFLOW_REGISTRY[step_type](
        workflow, config, config_lookup_paths, config_paths, os.getcwd(), task_name=task_name
    )

    if target_task is None or target_task == task_name:
        for f in wf_instance.get_result_files():
            if not f.endswith((".md5", ".tbi", ".txt")):
                # Prepend the task_name because the module's prefix directive
                # will namespace all targets
                all_target_files.append(os.path.join(task_name, f))

    dsl_lines.append(
        f"""
module {task_name}:
    snakefile: "workflows/{step_type}/Snakefile"
    config: config
    prefix: "{task_name}"

use rule * from {task_name} as {task_name}_*
"""
    )

# Write and include the dynamic imports
with tempfile.NamedTemporaryFile(
    mode="w", suffix=".smk", delete=False, delete_on_close=False
) as tmp:
    tmp.write("\n".join(dsl_lines))

    if config.get("dump_orchestrator"):
        print("=" * 80)
        print("RENDERED ORCHESTRATOR SNAKEFILE:")
        print("=" * 80)
        print("\n".join(dsl_lines))
        print("=" * 80)

    include: tmp.name

    rule all:
        input:
            all_target_files,
        default_target: True
