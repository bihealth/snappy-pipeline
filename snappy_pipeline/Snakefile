import os
import sys
from snappy_pipeline.base import ConfigError
from snappy_pipeline.orchestration import (
    ON_HOLD_STEPS,
    create_task_instances,
    load_project,
    register_hooks,
    select_target_tasks,
)
from snappy_pipeline.results import MANIFEST, link_results
from snappy_pipeline.rulegraph import (
    RULEGRAPH_CAPTION,
    RULEGRAPH_SVG,
    rule_graph_dot,
    write_rulegraph,
)
from snappy_pipeline.sheet_summary import print_library_summary
from snappy_pipeline.workflows.abstract import BaseStep

configfile: "config.yaml"

# Targeting mode:
#   default          - every task builds and links its result files into output/
#   config["task"]   - only the named task; upstream tasks run as far as it needs them
#   config["frozen"] - with "task": load only that task's rules; upstream outputs are inputs
target_task = config.get("task")
frozen = bool(config.get("frozen", False))

if target_task:
    _mode_desc = f"single task '{target_task}'" + (" (frozen upstream)" if frozen else "")
else:
    _mode_desc = "all tasks"

try:
    # Relative paths in the configuration are relative to the directory of the config file, even
    # when Snakemake runs in another directory (`snappy run` passes the file as --configfile)
    project = load_project(config, os.path.dirname(os.path.abspath(workflow.configfiles[0])))
    target_task_names = select_target_tasks(project, target_task)
    module_task_names = target_task_names if frozen else [task.name for task in project.tasks]
    task_instances = create_task_instances(workflow, project, module_task_names)
    print(f"[snappy] Targeting {_mode_desc}", flush=True)
    # Once per run, not again in each cluster job
    if workflow.is_main_process:
        print_library_summary(task_instances)
except ConfigError as e:
    # The user has to fix the configuration or the sample sheets; Snakemake would frame the
    # message with the location in this file and traceback lines
    print(f"[snappy] Error: {e}", file=sys.stderr, flush=True)
    sys.exit(1)

register_hooks(workflow)

for task in project.model.tasks:
    if task.name not in module_task_names:
        continue
    t_name = task.name
    t_step = task.step
    alias = t_name + "_"
    # Each task writes below tasks/<name>/
    task_root = BaseStep.task_root(t_name)
    prefixes = {d: f"{task_root}/{d}" for d in ("output/", "work/", "benchmarks/")}

    module:
        name: t_name
        snakefile: f"workflows/{t_step}/Snakefile"
        config: {"__task_name__": t_name}
        replace_prefix: prefixes

    known_rules = {r.name for r in workflow.rules}

    use rule * from t_name as alias*

    # The task's jobs join its job group; local rules stay local, which a group would prevent
    if job_group := project.task_configs[t_name].job_group:
        for task_rule in workflow.rules:
            if task_rule.name not in known_rules | workflow._localrules:
                task_rule.group = job_group

# One local job per targeted task links its result files from work/ into output/.
# The result files in work/ are targets themselves: a missing one (for example after a failed
# rerun) is rebuilt and linked again, which an existing manifest alone would not trigger.
targets = []
for t_name in target_task_names:
    result_files = list(task_instances[t_name].get_result_files())
    task_root = BaseStep.task_root(t_name)
    if project.task(t_name).step in ON_HOLD_STEPS:
        targets += [f"{task_root}/{f}" for f in result_files if not f.endswith((".md5", ".tbi"))]
        continue
    if not result_files:
        continue
    work_files = [f"{task_root}/{path}" for path in result_files]
    manifest = f"{task_root}/output/{MANIFEST}"
    targets += [*work_files, manifest]

    rule:
        name:
            f"{t_name}_results"
        input:
            work_files
        output:
            manifest
        params:
            task_dir=task_root
        localrule: True
        run:
            link_results(params.task_dir, list(input), output[0])

# The rule graph of the run as a metro map for the report: a local job in the main process draws
# the DAG itself with snakevision. Its input is the config file, so a changed task layout redraws
# it; the result-linking jobs and the final target stay out of the picture.
if not target_task:
    targets.append(RULEGRAPH_SVG)

    rule rulegraph:
        input:
            workflow.configfiles[0],
        output:
            report(RULEGRAPH_SVG, category="Workflow", caption=RULEGRAPH_CAPTION),
        localrule: True
        run:
            write_rulegraph(
                rule_graph_dot(
                    workflow.dag,
                    task_steps={task.name: task.step for task in project.model.tasks},
                    skip=["all", "rulegraph", *(f"{name}_results" for name in target_task_names)],
                ),
                output[0],
            )


rule all:
    input:
        targets
    default_target: True
